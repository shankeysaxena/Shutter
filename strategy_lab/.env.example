# Zerodha Kite Connect credentials
# Copy to .env and fill in your values.
# NEVER commit .env or .kite_token.json

KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Automated login (no browser) — required for zerodha auto-login
# KITE_USER_ID:     your Zerodha client ID (e.g. AB1234)
# KITE_PASSWORD:    your Zerodha login password
# KITE_TOTP_SECRET: base32 TOTP secret shown when you enabled 2FA in Zerodha
#                   looks like: JBSWY3DPEHPK3PXP
#                   if you only have the QR, scan it in any TOTP app and export the secret
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# Telegram notifications (optional but recommended for live-paper)
# 1. Message @BotFather → /newbot → copy the bot token
# 2. Send any message to your new bot
# 3. curl https://api.telegram.org/bot<TOKEN>/getUpdates → copy chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: pre-loaded access token (avoids re-auth on each run).
# Generated by: python -m src.cli.main zerodha login
# Stored automatically in .kite_token.json — do not set this manually
# unless you know what you're doing.
# KITE_ACCESS_TOKEN=
